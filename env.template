# Environment Configuration Template for TradingAgents

# Copy this file to .env and configure your settings

# ============================================================================
# Redis Configuration (L2 Cache - Hot Cache)
# ============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# MongoDB Configuration (L3 Cache + Persistent Storage)
# ============================================================================
MONGODB_ENABLED=true
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=tradingagents

# MongoDB Authentication (optional - leave empty for no auth)
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_AUTH_SOURCE=admin

# MongoDB Connection Pool
MONGO_MAX_CONNECTIONS=50
MONGO_MIN_CONNECTIONS=5

# MongoDB Timeouts (milliseconds)
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=20000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# MongoDB Storage Options
MONGODB_SAVE_ANALYSES=true
MONGODB_SAVE_NEWS=true
MONGODB_TRACK_USAGE=true

# MongoDB TTL Settings (days)
MONGODB_NEWS_TTL_DAYS=30
MONGODB_HISTORICAL_TTL_DAYS=90

# ============================================================================
# Logging Configuration
# ============================================================================
TRADINGAGENTS_LOG_LEVEL=INFO
TRADINGAGENTS_LOG_DIR=./logs

# ============================================================================
# Data API Keys
# ============================================================================
# Alpha Vantage (for fundamentals and news)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Google API (for global news)
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# LLM API Keys
# ============================================================================
# OpenAI
OPENAI_API_KEY=your_openai_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Gemini  
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# Results and Data Directories
# ============================================================================
TRADINGAGENTS_RESULTS_DIR=./results

