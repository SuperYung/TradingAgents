# TradingAgents Environment Configuration Template
# Copy this file to .env and configure with your values

# ============================================
# Cache Configuration
# ============================================

# Redis Cache (Optional - graceful fallback to file cache if disabled)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# File Cache
FILE_CACHE_ENABLED=true
FILE_CACHE_MAX_AGE_DAYS=7
FILE_CACHE_MAX_SIZE_GB=2
FILE_CACHE_CLEANUP_ON_STARTUP=false

# Cache TTL Settings (seconds)
# Uncomment and modify to override defaults

# Real-time data
# CACHE_TTL_STOCK_QUOTE=60              # 1 minute
# CACHE_TTL_HISTORICAL_DATA=3600        # 1 hour
# CACHE_TTL_STOCK_INFO=86400            # 24 hours

# Technical indicators
# CACHE_TTL_INDICATORS=3600             # 1 hour

# Fundamental data
# CACHE_TTL_FUNDAMENTALS=86400          # 24 hours
# CACHE_TTL_BALANCE_SHEET=86400         # 24 hours
# CACHE_TTL_INCOME_STATEMENT=86400      # 24 hours
# CACHE_TTL_CASHFLOW=86400              # 24 hours

# News data
# CACHE_TTL_NEWS=1800                   # 30 minutes
# CACHE_TTL_GLOBAL_NEWS=3600            # 1 hour
# CACHE_TTL_INSIDER_SENTIMENT=3600      # 1 hour
# CACHE_TTL_INSIDER_TRANSACTIONS=3600   # 1 hour

# ============================================
# MongoDB Configuration (Future - Phase 2)
# ============================================

MONGODB_ENABLED=false
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=tradingagents
MONGODB_AUTH_SOURCE=admin

# ============================================
# API Keys
# ============================================

# OpenAI (for LLMs and ChromaDB embeddings)
OPENAI_API_KEY=your-openai-key-here

# Alpha Vantage (for stock data)
ALPHAVANTAGE_API_KEY=your-alphavantage-key-here

# Google AI (optional)
GOOGLE_API_KEY=your-google-key-here

# ============================================
# LLM Configuration
# ============================================

# LLM Provider: openai, google, anthropic, ollama
LLM_PROVIDER=openai

# Model Selection
DEEP_THINK_LLM=o4-mini
QUICK_THINK_LLM=gpt-4o-mini

# Backend URL (for custom endpoints)
BACKEND_URL=https://api.openai.com/v1

# ============================================
# Data Vendors
# ============================================

# Core stock data: yfinance, alpha_vantage, local
VENDOR_CORE_STOCK_APIS=yfinance

# Technical indicators: yfinance, alpha_vantage, local
VENDOR_TECHNICAL_INDICATORS=yfinance

# Fundamental data: alpha_vantage, openai, local
VENDOR_FUNDAMENTAL_DATA=alpha_vantage

# News data: alpha_vantage, openai, google, local
VENDOR_NEWS_DATA=alpha_vantage

# ============================================
# Analysis Configuration
# ============================================

# Debate and discussion rounds
MAX_DEBATE_ROUNDS=1
MAX_RISK_DISCUSS_ROUNDS=1

# Directories
RESULTS_DIR=./results
DATA_DIR=./data

# ============================================
# Logging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log to file
LOG_TO_FILE=true
LOG_DIR=./logs

